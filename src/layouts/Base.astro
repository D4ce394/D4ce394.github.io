---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props { lang: 'en' | 'id'; alt: string }
const { lang, alt } = Astro.props;
const title = `${profile.fullName} · ${profile.role}`;
const description = lang === 'id'
  ? `${profile.fullName}, backend developer dari Bandung dengan Python, Django REST Framework, FastAPI, dan Docker. Terbuka untuk posisi backend, full-stack, data analyst, dan AI engineer.`
  : `${profile.fullName}, backend developer from Bandung working with Python, Django REST Framework, FastAPI and Docker. Open to backend, full-stack, data analyst and AI engineer roles.`;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<link rel="alternate" hreflang={lang === 'id' ? 'en' : 'id'} href={alt}>
<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}d4ce-mask.png`}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:opsz,wght@9..40,400..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
<slot />
<script src="../scripts/main.js"></script>
</body>
</html>
